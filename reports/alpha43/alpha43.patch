diff --git a/kubejs/server_scripts/nasledie_artillery.js b/kubejs/server_scripts/nasledie_artillery.js
new file mode 100644
index 0000000..e7a6984
--- /dev/null
+++ b/kubejs/server_scripts/nasledie_artillery.js
@@ -0,0 +1,59 @@
+// Credits artillery kills from Create Big Cannons 5.11.4. Its projectiles carry no player owner, so a kill
+// is detected by the damage type message id (data/createbigcannons/damage_type/*.json: "createbigcannons.*")
+// and credited to players near the victim. Grants nasledie:events/artillery/... (minecraft:impossible).
+var NasledieArtillery = (function () {
+    var RADIUS = 128;
+    var uuidPattern = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+    var bosses = {
+        'minecraft:wither': true, 'minecraft:ender_dragon': true, 'minecraft:warden': true, 'minecraft:elder_guardian': true,
+        'cataclysm:ender_guardian': true, 'cataclysm:netherite_monstrosity': true, 'cataclysm:ignis': true,
+        'cataclysm:the_harbinger': true, 'cataclysm:the_leviathan': true, 'cataclysm:ancient_remnant': true,
+        'cataclysm:maledictus': true, 'cataclysm:scylla': true,
+        'mowziesmobs:ferrous_wroughtnaut': true, 'mowziesmobs:frostmaw': true, 'mowziesmobs:umvuthi': true,
+        'alexscaves:hullbreaker': true, 'alexscaves:luxtructosaurus': true, 'alexscaves:forsaken': true,
+        'alexsmobs:void_worm': true
+    };
+
+    function isArtillery(source) {
+        var id = source ? String(source.getMsgId()) : '';
+        return id.indexOf('createbigcannons.') === 0;
+    }
+
+    function witnesses(server, victim) {
+        var result = [];
+        server.getPlayers().forEach(function (player) {
+            if (player.level !== victim.level || !player.isAlive()) return;
+            var dx = Number(player.x) - Number(victim.x);
+            var dy = Number(player.y) - Number(victim.y);
+            var dz = Number(player.z) - Number(victim.z);
+            if (dx * dx + dy * dy + dz * dz <= RADIUS * RADIUS) result.push(player);
+        });
+        return result;
+    }
+
+    function grant(server, player, path) {
+        var uuid = String(player.uuid);
+        if (uuidPattern.test(uuid)) server.runCommandSilent('advancement grant ' + uuid + ' only nasledie:events/artillery/' + path);
+    }
+
+    function onDeath(event) {
+        if (!isArtillery(event.source)) return;
+        var victim = event.entity;
+        var server = victim.server;
+        if (!server || victim.player) return;
+        var boss = bosses[String(victim.type)] === true;
+        witnesses(server, victim).forEach(function (player) {
+            grant(server, player, 'kill');
+            if (boss) grant(server, player, 'boss');
+        });
+    }
+
+    EntityEvents.death(function (event) {
+        try {
+            onDeath(event);
+        } catch (error) {
+            console.error('[Nasledie artillery] ' + error);
+        }
+    });
+    return {isArtillery: isArtillery, bosses: bosses};
+})();
diff --git a/kubejs/server_scripts/nasledie_notes.js b/kubejs/server_scripts/nasledie_notes.js
new file mode 100644
index 0000000..9b872f6
--- /dev/null
+++ b/kubejs/server_scripts/nasledie_notes.js
@@ -0,0 +1,77 @@
+// Loose pages of the First Expedition, added to chests where its members went (lore only: no quest checks them).
+// Loot table IDs come from the mod JARs (structure NBT and data/*/loot_tables). Lootr rolls each player's copy
+// separately, so Maxim and Yura can each find their own page. A written book title must stay within 32 characters
+// (WrittenBookItem.makeSureTagIsValid), otherwise the client shows "Invalid book tag".
+var NasledieNotes = (function () {
+    var notes = [
+        {table: 'mowziesmobs:chests/monastery_chest', chance: 3, title: 'Тропа к отшельнику', author: 'Сигрид Линд',
+            pages: ['Старик наверху не пускает тех, кто строит или летит. Только ногами.\n\nЭклунд злился полдня — и полез.',
+                'Наверху Эклунд долго говорил с ним один. Спустился молча и до вечера ничего не записывал.']},
+        {table: 'mowziesmobs:chests/umvuthana_grove_chest', chance: 3, title: 'Маска за компас', author: 'Эйнар Холм',
+            pages: ['Отдал компас за маску. Без маски в рощу не пустят, а в маске не выпустят, если узнают.\n\nЭклунд сказал — пустяки. Ему легко говорить, маску ношу я.']},
+        {table: 'betterstrongholds:chests/grand_library', chance: 2, title: 'Выписки из библиотеки', author: 'Торвальд Эклунд',
+            pages: ['Письмена у портала моложе остальных. Кто-то из Зодчих вернулся сюда уже после обряда.',
+                'Значит, из сосуда можно выйти.\n\nА если можно выйти — можно и войти.']},
+        {table: 'minecraft:chests/ancient_city', chance: 4, title: 'Обломок таблички', author: 'Неизвестный Зодчий',
+            pages: ['…и каждый, кто отдаёт голос, слышит после только стражу.\n\nМы согласны.\nМы согласны.\nМы…']},
+        {table: 'cataclysm:chests/desert_treasure', chance: 3, title: 'Под храмом — ещё храм', author: 'Эйнар Холм',
+            pages: ['Пустынники строили поверх старого. Под их храмами — кладка Зодчих, а под ней ещё одна.\n\nСколько раз этот мир уже чинили?']},
+        {table: 'cataclysm:chests/frosted_prison_treasure', chance: 3, title: 'Пар у входа', author: 'Ингрид Берг',
+            pages: ['Драугры не дышат, а у входа идёт пар. Здесь кто-то ещё живой.\n\nИли помнит, как это — быть живым.']},
+        {table: 'cataclysm:chests/acropolis_treasure', chance: 3, title: 'Восемь швов', author: 'Сигрид Линд',
+            pages: ['Отсюда видны все швы сразу. Я отметила их на карте — восемь, как он и говорил.',
+                'Он знал заранее.\n\nОткуда?']},
+        {table: 'cataclysm:chests/abandoned_treasure', chance: 3, title: 'Записка Странда', author: 'Улоф Странд',
+            pages: ['Если найдёте мой ящик с инструментом — берите, мне он не понадобится.\n\nШучу. Наверное.']},
+        {table: 'alexscaves:chests/forlorn_ruins', chance: 3, title: 'Обрывок, рука Берг', author: 'Ингрид Берг',
+            pages: ['Они видят в темноте не глазами. Я закрыла глаза — и тоже увидела.\n\nНе ищите меня.']},
+        {table: 'alexscaves:chests/abyssal_ruins', chance: 3, title: 'Песня, выбитая в камне', author: 'Народ глубин',
+            pages: ['Мы держали воду для тех, кто наверху.\nНаверху забыли.\nВода помнит.']}
+    ];
+
+    function quote(text) {
+        return '"' + String(text).replace(/\\/g, '\\\\').replace(/"/g, '\\"') + '"';
+    }
+
+    // SNBT for minecraft:set_nbt; pages are JSON text components, as in a signed book.
+    function bookTag(note) {
+        var pages = note.pages.map(function (page) { return quote(JSON.stringify({text: page})); });
+        return '{title:' + quote(note.title) + ',author:' + quote(note.author) + ',pages:[' + pages.join(',') + ']}';
+    }
+
+    function entry(note) {
+        return {type: 'minecraft:item', name: 'minecraft:written_book',
+            functions: [{function: 'minecraft:set_nbt', tag: bookTag(note)}]};
+    }
+
+    // ServerEvents.chestLootTables adds "chests/" to the path itself (LootEventJS.modify/addJson),
+    // so 'mowziesmobs:chests/monastery_chest' is passed as 'mowziesmobs:monastery_chest'.
+    function eventId(table) {
+        var parts = table.split(':');
+        if (parts.length !== 2 || parts[1].indexOf('chests/') !== 0) throw new Error('not a chest loot table: ' + table);
+        return parts[0] + ':' + parts[1].substring('chests/'.length);
+    }
+
+    // One extra roll per chest: the page with weight 1 against `chance - 1` empty results (1 in `chance`).
+    function register(event) {
+        notes.forEach(function (note) {
+            try {
+                event.modify(eventId(note.table), function (table) {
+                    table.addPool(function (pool) {
+                        pool.setUniformRolls(1, 1);
+                        pool.addEntry(entry(note)).weight(1);
+                        pool.addEmpty(note.chance - 1);
+                    });
+                });
+            } catch (e) {
+                console.error('nasledie notes: ' + note.table + ': ' + e);
+            }
+        });
+    }
+
+    return {notes: notes, bookTag: bookTag, eventId: eventId, register: register};
+})();
+
+ServerEvents.chestLootTables(function (event) {
+    NasledieNotes.register(event);
+});
diff --git a/kubejs/startup_scripts/nasledie_events.js b/kubejs/startup_scripts/nasledie_events.js
new file mode 100644
index 0000000..238d9aa
--- /dev/null
+++ b/kubejs/startup_scripts/nasledie_events.js
@@ -0,0 +1,56 @@
+// Grants nasledie:events/... advancements for mod events that have no advancement trigger.
+// Recruits 1.15.2 posts RecruitEvent$Hired / $Promoted / $LevelUp on the Forge bus (server side);
+// Workers 2.0.3 entities extend AbstractRecruitEntity, so hiring a worker posts the same event.
+// Every target advancement uses minecraft:impossible; a missing one is ignored by the silent command.
+var NasledieEvents = (function () {
+    var registries = Java.loadClass('net.minecraftforge.registries.ForgeRegistries');
+    var uuidPattern = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+    var levels = [3, 5];
+
+    function grant(player, path) {
+        if (!player) return;
+        var server = player.getServer();
+        var uuid = String(player.getStringUUID());
+        if (!server || !uuidPattern.test(uuid) || !/^[a-z0-9_\/]+$/.test(path)) return;
+        server.runCommandSilent('advancement grant ' + uuid + ' only nasledie:events/' + path);
+    }
+
+    function typeOf(entity) {
+        var key = registries.ENTITY_TYPES.getKey(entity.getType());
+        return key ? String(key) : '';
+    }
+
+    function hired(event) {
+        var type = typeOf(event.getRecruit());
+        var namespace = type.split(':')[0];
+        if (namespace !== 'recruits' && namespace !== 'workers') return;
+        grant(event.getPlayer(), 'hired/' + namespace);
+        grant(event.getPlayer(), 'hired/' + type.replace(':', '/'));
+    }
+
+    function promoted(event) {
+        grant(event.getPromotingPlayer(), 'recruits/promoted');
+    }
+
+    function levelUp(event) {
+        var recruit = event.getRecruit();
+        var level = Number(event.getNewLevel());
+        if (levels.indexOf(level) === -1) return;
+        grant(recruit.getOwner(), 'recruits/level_' + level);
+    }
+
+    function safely(name, handler) {
+        return function (event) {
+            try {
+                handler(event);
+            } catch (error) {
+                console.error('[Nasledie events] ' + name + ': ' + error);
+            }
+        };
+    }
+
+    ForgeEvents.onEvent('com.talhanation.recruits.RecruitEvent$Hired', safely('hired', hired));
+    ForgeEvents.onEvent('com.talhanation.recruits.RecruitEvent$Promoted', safely('promoted', promoted));
+    ForgeEvents.onEvent('com.talhanation.recruits.RecruitEvent$LevelUp', safely('levelUp', levelUp));
+    return {grant: grant};
+})();
