			]
			_chapter: "nasledie_village"
		}
		{
			id: "1E8EACC187073285"
			title: "Город за холмами"
			description: ["Кроме хуторов, в мире встречаются большие поселения с рынками, укреплениями и десятками домов. Найдите такое — там лучшие торговцы и больше всего работы."]
			x: 0.0d
			y: -3.0d
			icon: "minecraft:cartography_table"
			icon_scale: 0.6d
			shape: "expedition"
			optional: true
