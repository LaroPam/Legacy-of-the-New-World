		}
		{
			id: "1D78C33928B611DC"
			title: "Юра встречает Новый год"
			description: ["Среди снегов стоят деревни, где круглый год ёлки и гирлянды. Юра уверен, что сейчас декабрь. Поторгуйтесь там — и не разубеждайте его."]
			x: -2.47d
			y: -5.47d
			icon: "minecraft:spruce_sapling"
