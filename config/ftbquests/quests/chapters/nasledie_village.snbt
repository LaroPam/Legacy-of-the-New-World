	quest_links: [ ]
	quests: [
		{
			id: "43524B3B7A1175C3"
			title: "Первые соседи"
			description: ["В этом мире у жителей есть имена, характеры и семьи. Зайдите в деревню и познакомьтесь — здесь можно найти друзей, торговцев и тех, кто однажды встанет с вами на стены."]
			x: 0.0d
			y: 0.0d
			icon: "minecraft:bell"
			icon_scale: 0.6d
			shape: "home"
			size: 1.4d
			tasks: [{
				id: "029CC9D31DED7CCC"
