			]
			_chapter: "nasledie_village"
		}
		{
			id: "61A27DD45708092E"
			title: "Деревня в кронах"
			description: ["В джунглях встречаются деревни, построенные прямо на деревьях, — мостки, лестницы и дома среди листвы. Поднимитесь туда и поторгуйтесь с жителями. Вниз лучше не смотреть."]
			x: -3.45d
			y: -3.61d
			icon: "minecraft:jungle_log"
			icon_scale: 0.6d
			shape: "expedition"
			optional: true
			dependencies: ["1E8EACC187073285"]
			tasks: [{
				id: "5BFC51CCDF4AF507"
				type: "advancement"
				title: "Поторговать в деревне на деревьях"
