	quests: [
		{
			id: "305D6F5E90BFA385"
			title: "Ночлег"
			description: ["Экспедиция начинается не с карты, а с места, куда хочется вернуться. Поставьте кровать и переночуйте — так мир запомнит, где ваш дом."]
			x: 0.0d
			y: 0.0d
