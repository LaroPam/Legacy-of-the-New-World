		{
			id: "4322668146484A1C"
			title: "Нож повара"
			description: ["Даже дальняя вылазка начинается с хорошего ужина. Сделайте кухонный нож — кремнёвого вполне хватит. Им режут продукты на доске и срезают солому с травы."]
			x: 3.0d
			y: 0.0d
			icon: "farmersdelight:flint_knife"
