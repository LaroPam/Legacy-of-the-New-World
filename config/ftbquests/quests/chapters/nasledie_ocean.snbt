		{
			id: "76F24423146B2BF8"
			title: "Монумент на дне"
			description: ["На дне стоит монумент, сложенный той же кладкой, что кованый зал. Найдите его и присмотрите место для плацдарма рядом."]
			x: 9.0d
			y: 0.0d
			icon: "minecraft:prismarine_bricks"
			icon_scale: 0.6d
			dependencies: ["770436662909AF80"]
			tasks: [{
				id: "18EACFBBC34C012C"
