	quests: [
		{
			id: "268C40E37C45E3BF"
			title: "Выйти в глубокий океан"
			description: ["Где дно уходит в темноту, начинается настоящее море. Выйдите в глубокий океан — лодка, запас еды и путь назад по звёздам."]
			x: 0.0d
			y: 0.0d
			icon: "minecraft:oak_boat"
			icon_scale: 0.6d
			size: 1.4d
			dependencies: ["00C7DAA7BBBE1ABD"]
			tasks: [{
				id: "55740A280B316AEA"
				type: "biome"
				biome: "minecraft:deep_ocean"
			}]
			rewards: [
