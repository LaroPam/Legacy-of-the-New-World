			]
			_chapter: "nasledie_ocean"
		}
		{
			id: "770436662909AF80"
			title: "Клад по карте"
			description: ["Карта ведёт к кладу на берегу. Копайте под крестом — внутри всегда лежит сердце моря, главная деталь проводника."]
			x: 6.0d
			y: 0.0d
			icon: "minecraft:heart_of_the_sea"
			icon_scale: 0.6d
			dependencies: ["55B701274F41916E"]
