			]
			_chapter: "nasledie_ocean"
		}
		{
			id: "55B701274F41916E"
			title: "Затонувший корабль"
			description: ["Корабли тонули здесь и до экспедиции. В капитанском сундуке обычно лежит карта к зарытому кладу. Откройте его."]
			x: 3.0d
			y: 0.0d
			icon: "minecraft:oak_planks"
			icon_scale: 0.6d
			dependencies: ["268C40E37C45E3BF"]
			tasks: [{
				id: "4C3E8F0C021CCF8D"
				type: "advancement"
				title: "Открыть сундук с сокровищами корабля"
				advancement: "nasledie:q/ocean/shipwreck"
			}]
			rewards: [
