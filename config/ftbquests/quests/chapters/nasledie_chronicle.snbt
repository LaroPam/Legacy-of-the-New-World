				{
					id: "013782BAE0C4B6B4"
					type: "item"
					item: {
						Count: 1b
						id: "minecraft:written_book"
						tag: {
							title: "Запись Эйнара Холма, I"
							author: "Эйнар Холм, археолог"
							pages: [
								"{\"text\": \"Солнечный народ носит маски. Меня пустили в рощу в маске — я выменял её на нож и два слитка.\"}"
								"{\"text\": \"Жрец рассказал: давным-давно строители зажгли птицу из солнца и велели её кормить. Они кормят до сих пор. Если птица голодна, огонь уходит из мира.\"}"
								"{\"text\": \"Эклунд велел её убить — сказал, это проверка. Птица горела ещё долго после смерти.\\n\\nЭклунд стоял к огню ближе всех.\"}"
							]
						}
					}
				}
			]
		}
		{
			id: "DF85EFBB8E452760"
			title: "Слово отшельника"
			description: ["На вершине над монастырём живёт отшельник, который лепит камень как глину. Он пускает к себе только тех, кто пройдёт его испытание. Поднимитесь по ожившей скале и не сорвитесь."]
			x: 10.0d
