					id: "CA2BDC2C1C8E3DC9"
					type: "item"
					item: {
						Count: 12b
						id: "minecraft:ender_eye"
					}
				}
				{
					id: "ED6BFF0FAD3E7EA0"
					type: "item"
					item: {
						Count: 1b
						id: "minecraft:written_book"
						tag: {
							title: "Запись Торвальда Эклунда, IV"
							author: "Торвальд Эклунд"
							pages: [
								"{\"text\": \"Линд думала, что успеет предупредить. Она не учла: я знаю, где лежит каждый лист.\\n\\nЭтот я оставил сам.\"}"
								"{\"text\": \"Двадцать лет. Огонь, холод, буря, машина — всё во мне. Не хватает пустоты. Её стережёт последний доспех в цитадели Края.\"}"
								"{\"text\": \"Вы сильны, раз дочитали.\\n\\nПриходите. Я покажу вам, что такое наследие.\"}"
							]
						}
					}
				}
			]
			min_required_dependencies: 4
		}
