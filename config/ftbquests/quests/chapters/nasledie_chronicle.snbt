					}
				}
				{
					id: "09873DB0F23EBB7D"
					type: "item"
					item: {
						Count: 1b
						id: "minecraft:written_book"
						tag: {
							title: "Запись Улофа Странда, III"
							author: "Улоф Странд, инженер"
							pages: [
								"{\"text\": \"Если вы это нашли — я не вышел. Машина проснулась, когда Эклунд коснулся пульта. Я видел: он сделал это нарочно.\"}"
								"{\"text\": \"Предвестник не нападал на него. Только на нас.\"}"
								"{\"text\": \"Берг уводит раненых. Линд рисует выход. Я держу дверь.\\n\\nПростите, что пишу криво — рука уже не моя.\"}"
							]
						}
					}
				}
			]
		}
		{
			id: "52813202FFECF301"
			title: "Кузнец, ставший молотом"
			description: ["Око чудовища ведёт в Нижний мир, к кузне душ. Её последний мастер давно стал частью наковальни. Победите незеритовое чудище."]
			x: 15.5d
			y: 8.8d
			icon: "cataclysm:monstrous_helm"
