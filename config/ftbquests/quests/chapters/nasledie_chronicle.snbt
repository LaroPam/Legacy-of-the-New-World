						tag: {
							title: "Песня глубинников"
							author: "Народ глубин"
							pages: [
								"{\"text\": \"Строители дали нам море и дали морю зверя. Зверь — их боль, ушедшая в глубину, чтобы не тревожить землю.\"}"
								"{\"text\": \"Мы пели ему, чтобы он спал.\\n\\nЧужаки пришли без песни. Теперь мы молчим, и он не спит.\"}"
