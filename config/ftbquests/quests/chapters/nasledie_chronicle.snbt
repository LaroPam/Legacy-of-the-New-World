						tag: {
							title: "Присяга на стене арены"
							author: "Неизвестный Зодчий"
							pages: [
								"{\"text\": \"Мы, рыцари огня, приняли пламя в себя, чтобы оно не сожгло мир.\\n\\nПусть горит в нас, а не в полях.\"}"
								"{\"text\": \"Если придёт тот, кто погасит нас, — пусть знает: огонь не исчезнет. Он ищет новый сосуд.\\n\\nНе будь им.\"}"
							]
						}
