					}
				}
				{
					id: "2D57A528FCF89ED5"
					type: "item"
					item: {
						Count: 1b
						id: "minecraft:written_book"
						tag: {
							title: "Запись Сигрид Линд, IV"
							author: "Сигрид Линд, картограф"
							pages: [
								"{\"text\": \"Сегодня я нашла в сумке Эклунда пачку листов. Наших листов — Холма, Странда, Берг. Он их не терял. Он их раскладывал.\"}"
								"{\"text\": \"Он оставляет их там, где найдут. Ему нужны следующие — те, кто пройдёт путь до конца и разобьёт оставшиеся сосуды за него.\"}"
								"{\"text\": \"Если вы это читаете — вы уже на его тропе. Остановитесь.\\n\\nИли дойдите до конца, но не отдавайте ему того, что освободите.\"}"
							]
						}
					}
				}
			]
		}
		{
			id: "A80C23723A869A8B"
			title: "Он жив"
			description: ["Стражи падают один за другим. Когда падут хотя бы четверо из пяти пробуждённых, в крепости, где спит портал в Край, вас ждёт свежая страница — подписанная человеком, который «погиб» двадцать лет назад. Найдите крепость."]
			x: 28.5d
			y: 2.5d
			icon: "minecraft:ender_eye"
			shape: "star"
			size: 1.7d
