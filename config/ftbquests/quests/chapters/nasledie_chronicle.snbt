				{
					id: "F445716680CD6384"
					type: "item"
					item: {
						Count: 1b
						id: "minecraft:written_book"
						tag: {
							title: "Запись Сигрид Линд, III"
							author: "Сигрид Линд, картограф"
							pages: [
								"{\"text\": \"Монументы строили не рыбы. Странд говорит, кладка та же, что в кованом зале.\"}"
								"{\"text\": \"Старшие стражи сторожат пустые залы. Эклунд сказал: они охраняют дорогу, а не то, что в конце.\\n\\nЗначит, конец дороги где-то ещё.\"}"
							]
						}
					}
				}
			]
		}
		{
			id: "B433E7FAF2F51B45"
			title: "Очи Зодчих"
			description: ["Эклунд писал об «очах», что ведут к сосудам. Соберите любое око Катаклизма — у каждого свой рецепт, и все начинаются с ока Края. Брошенное око летит к своему логову."]
			x: 10.0d
