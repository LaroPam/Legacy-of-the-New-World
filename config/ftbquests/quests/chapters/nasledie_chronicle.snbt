				{
					id: "D511C0567A842ADC"
					type: "item"
					item: {
						Count: 1b
						id: "minecraft:written_book"
						tag: {
							title: "Запись Торвальда Эклунда, II"
							author: "Торвальд Эклунд"
							pages: [
								"{\"text\": \"Кузня душ. Здесь Зодчие сплавляли металл и волю. Чудище у наковальни — их последний кузнец, ставший собственным молотом.\"}"
								"{\"text\": \"Странд погиб глупо. Он не понимал: стража нельзя победить и оставить как есть. Сила ищет хозяина.\"}"
								"{\"text\": \"Когда чудище упало, жар вошёл мне в руки. Я почти не чувствую боли.\\n\\nОстальным знать не нужно.\"}"
							]
						}
					}
				}
			]
		}
		{
			id: "1175C66EAEDBF91E"
			title: "Пробуждённые"
			description: ["После фабрики и кузни стражи начали просыпаться сами. Их слуги выходят навстречу — ревенанты, драугры, глубинники. Победите любого из младших стражей Катаклизма."]
			x: 21.0d
