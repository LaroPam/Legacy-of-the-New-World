				{
					id: "BBD591C8A5238A20"
					type: "item"
					item: {
						Count: 1b
						id: "minecraft:written_book"
						tag: {
							title: "Запись Эйнара Холма, II"
							author: "Эйнар Холм, археолог"
							pages: [
								"{\"text\": \"Пирамида. Песок здесь шепчет. Эклунд нашёл ожерелье и надел его мне на шею — сказал, оно откроет дверь.\"}"
								"{\"text\": \"Дверь открылась. Из-под песка поднялся правитель, сухой, как сама пустыня. Он смотрел не на Эклунда — на меня. На ожерелье.\"}"
								"{\"text\": \"Песок поднимается.\\n\\nЯ понял, зачем меня взяли. Ключ всегда идёт первым.\"}"
							]
						}
					}
				}
			]
		}
		{
			id: "A13ADF5DA222DA68"
			title: "Король во льду"
			description: ["Король Зодчих запер себя в ледяной тюрьме вместе со стражей, чтобы не выпустить проклятие. Драугры до сих пор несут караул. Победите Маледиктуса."]
			x: 24.5d
