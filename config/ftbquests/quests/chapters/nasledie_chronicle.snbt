					xp: 500
				}
				{
					id: "ADBD9DC120FF057E"
					type: "item"
					item: {
						Count: 1b
						id: "artifacts:power_glove"
					}
				}
				{
					id: "7ABCA565E65251A2"
					type: "item"
					item: {
						Count: 1b
						id: "minecraft:written_book"
						tag: {
							title: "Запись Улофа Странда, I"
							author: "Улоф Странд, инженер"
							pages: [
								"{\"text\": \"Под горой — зал, кованый целиком. В центре стоял доспех. Пустой: я заглянул в забрало и увидел темноту.\\n\\nПотом доспех повернул голову.\"}"
								"{\"text\": \"Мы отбились. Эклунд записал: «пробный сосуд». Я спросил — пробный для чего? Он не ответил.\\n\\nЖелезо не должно ненавидеть. Кто-то его научил.\"}"
							]
						}
					}
				}
			]
		}
		{
			id: "A378D8F13118FF97"
			title: "Птица из солнца"
			description: ["Солнечный народ кормит свою птицу уже тысячу лет. Экспедиция пришла к ним с подарками, а ушла, оставив за собой пепел. Победите Умвути."]
			x: 10.0d
			y: -3.6d
			icon: "mowziesmobs:sol_visage"
