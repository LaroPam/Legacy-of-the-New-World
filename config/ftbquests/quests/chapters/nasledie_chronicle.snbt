				}
				{
					id: "E8BFBA3C0477A9AF"
					type: "item"
					item: {
						Count: 1b
						id: "minecraft:written_book"
						tag: {
							title: "Запись Торвальда Эклунда, III"
							author: "Торвальд Эклунд"
							pages: [
								"{\"text\": \"Ледяная тюрьма. Король заперся здесь со своей стражей, чтобы не выпустить проклятие. Его драугры до сих пор несут караул.\"}"
								"{\"text\": \"Он почти человек. Он говорил со мной. Просил закрыть дверь снаружи и уйти.\"}"
								"{\"text\": \"Я не ушёл.\\n\\nХолод теперь живёт в моих пальцах рядом с жаром. Они уживаются. Я — уживаюсь.\"}"
							]
						}
					}
				}
			]
		}
