					}
				}
				{
					id: "AC98ED0F150CA845"
					type: "item"
					item: {
						Count: 1b
						id: "minecraft:written_book"
						tag: {
							title: "Запись Ингрид Берг, II"
							author: "Ингрид Берг, врач"
							pages: [
								"{\"text\": \"Эклунд нашёл рецепт в стене крепости: песок душ и три черепа. Сказал, это обряд Зодчих. Мы провели его ночью.\"}"
								"{\"text\": \"Из песка поднялись три головы на одном хребте. Три души, сплавленные силой. Оно кричало тремя голосами, пока мы его убивали.\"}"
								"{\"text\": \"Звезда, что осталась, тёплая. Эклунд держал её в руке очень долго.\\n\\nЯ больше не верю, что мы здесь, чтобы что-то закрывать.\"}"
							]
						}
					}
				}
			]
		}
