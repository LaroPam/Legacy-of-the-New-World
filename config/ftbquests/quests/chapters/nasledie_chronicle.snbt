				}
				{
					id: "860B0832FD78ED99"
					type: "item"
					item: {
						Count: 1b
						id: "minecraft:written_book"
						tag: {
							title: "Запись Ингрид Берг, I"
							author: "Ингрид Берг, врач"
							pages: [
								"{\"text\": \"Звери у швов мира меняются. Морозная пасть спала у старого обрыва, и снег вокруг неё не таял сотни лет.\"}"
								"{\"text\": \"Она не страж и не сосуд. Просто зверь, который вырос рядом с чужой силой и стал на неё похож.\\n\\nКак и мы, если задержимся здесь надолго.\"}"
							]
						}
					}
				}
			]
		}
		{
			id: "7561C2A49CE25872"
			title: "Дозорный монумента"
			description: ["Подводные монументы сложены той же кладкой, что и кованый зал. Старший страж сторожит их тысячи лет. Спуститесь к нему и победите."]
