					}
				}
				{
					id: "B1035FD95CFCE815"
					type: "item"
					item: {
						Count: 1b
						id: "minecraft:written_book"
						tag: {
							title: "Запись Сигрид Линд, II"
							author: "Сигрид Линд, картограф"
							pages: [
								"{\"text\": \"Отшельник не назвал имени. Он испытывает каждого, кто поднимается. Я прошла.\"}"
								"{\"text\": \"Он сказал: «Зодчие отдали себя сосудам, чтобы мир не рассыпался. Кто разбивает сосуд, берёт на себя их ношу — или их силу».\\n\\nЯ спросила: что выберет человек?\"}"
								"{\"text\": \"Он посмотрел вниз, туда, где ждал Эклунд, и ничего не ответил.\"}"
							]
						}
					}
				}
			]
		}
		{
			id: "92AF3238F7B8776E"
			title: "Зверь зимы"
			description: ["В снегах спит морозная пасть — зверь, рядом с которым снег не тает веками. Разбудите её и победите. Ледяной кристалл у неё на шее стоит того, чтобы рискнуть."]
