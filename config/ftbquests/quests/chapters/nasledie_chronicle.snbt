					item: {
						Count: 1b
						id: "minecraft:written_book"
						tag: {
							title: "Запись Улофа Странда, II"
							author: "Улоф Странд, инженер"
							pages: [
								"{\"text\": \"Фабрика. Внутри всё ещё работает: трубы гудят, ленты ползут, а в центре зала спит машина размером с дом.\"}"
								"{\"text\": \"Это не страж. Это мастер Зодчих, который отказался от тела и собрал себя из железа. Он не забыл ремесло — он забыл, зачем.\"}"
								"{\"text\": \"Оставляю чертежи: против машины нужна машина. Пушки, броня, своя мастерская.\\n\\nЭклунд торопит. Говорит, у нас нет времени. У кого — у нас?\"}"
							]
						}
					}
				}
			]
		}
