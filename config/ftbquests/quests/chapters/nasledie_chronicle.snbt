						Count: 4b
						id: "minecraft:ender_eye"
					}
				}
				{
					id: "82DBAE31EE90683C"
					type: "item"
					item: {
						Count: 1b
						id: "minecraft:written_book"
						tag: {
							title: "Запись Торвальда Эклунда, I"
							author: "Торвальд Эклунд"
							pages: [
								"{\"text\": \"Око Края смотрит туда, где мир тоньше. Зодчие делали свои очи — каждое смотрит на один сосуд.\"}"
								"{\"text\": \"Огонь, бездна, буря, проклятие, пустыня, машина, чудовище, пустота. Восемь. Одного глаза хватит, чтобы найти дверь.\"}"
								"{\"text\": \"Странд спрашивает, зачем нам двери. Я сказал — чтобы закрыть их.\\n\\nОн поверил. Пока.\"}"
							]
						}
					}
				}
			]
		}
		{
			id: "88304673F4543996"
			title: "Три души в одной"
			description: ["В стене крепости Эклунд нашёл обряд — песок душ и три черепа. Проведите его сами и победите то, что поднимется из песка. Лучше подальше от дома."]
