                }
            ]
        }
        {
            id: "91C8A76B406CF0AF"
            title: "Ветряк для удалённой мастерской"
            x: 5.00d
            y: 2.50d
            icon: "create:sail_frame"
            shape: "gear"
            size: 1.20d
            dependencies: [
                "3FA8926603B35ADD"
            ]
            description: [
                "Соберите и запустите ветряк на ветряном подшипнике. Он пригодится для мельницы, лесной мастерской и других установок, где неудобно подводить воду. Это альтернативный источник вращения, а не обязательный способ заставить пресс работать."
                "Прикрепите к подшипнику конструкцию с парусами и соберите её взаимодействием с подшипником. От его неподвижной стороны передайте вращение валом к станкам. Чем больше действующих парусов, тем больше доступный запас мощности — расширяйте установку по потребностям производства."
            ]
            tasks: [
                {
                    id: "708E0E91AC49CB3B"
                    type: "advancement"
                    advancement: "create:windmill"
                }
            ]
            rewards: [
                {
