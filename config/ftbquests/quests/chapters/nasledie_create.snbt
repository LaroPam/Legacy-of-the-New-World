                    type: "xp"
                    xp: 110
                }
                {
                    id: "E1E7D9F7C612174F"
                    type: "item"
                    item: { Count: 1b, id: "create:clipboard" }
                }
            ]
        }
        {
            id: "013B127CA07E038A"
            title: "Пресс открывает новые машины"
            x: 10.00d
            y: 0.00d
            icon: "create:mechanical_press"
            shape: "gear"
            size: 1.20d
            dependencies: ["37C2A96BD4EE0C5C"]
            description: [
                "Обработайте металл механическим прессом. Подведите вращение к его валу, поставьте под прессом депо и положите на него слиток по рецепту металлического листа."
                "Железные листы нужны для пропеллера вентилятора и венчика миксера. Поэтому пресс — ваш переход от простого вращения к обработке еды и смешиванию материалов. Приготовьте запас листов для обоих устройств."
            ]
            tasks: [
                {
                    id: "5E0CBC1F12029523"
                    type: "advancement"
                    advancement: "create:mechanical_press"
                }
            ]
            rewards: [
