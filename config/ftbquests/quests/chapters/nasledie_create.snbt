                    item: { Count: 1b, id: "create:blue_toolbox" }
                }
            ]
        }
        {
            id: "82EB3ADD3D2CD6B9"
            title: "Вентилятор вместо ручной печи"
            x: 17.50d
            y: 0.00d
            icon: "create:encased_fan"
            shape: "gear"
            size: 1.20d
            dependencies: ["95DD2AD4CCAA7D90"]
            description: [
                "Поставьте вентилятор Create и подайте вращение. Сам по себе он перемещает воздух и предметы; для обработки материала поток должен пройти через подходящую среду."
                "Для пекарни приготовьте два участка: вода на пути потока для промывки муки и зажжённый костёр для копчения теста. Предметы размещайте дальше по потоку, на депо. Направление воздуха зависит от направления вращения."
            ]
            tasks: [
                {
                    id: "271C27A5780C7688"
                    type: "advancement"
                    advancement: "create:encased_fan"
                }
            ]
            rewards: [
