                    type: "xp"
                    xp: 120
                }
                {
                    id: "4A5CA5F4E96C051C"
                    type: "item"
                    item: { Count: 1b, id: "create:goggles" }
                }
            ]
        }
        {
            id: "1245D0A9CAC83D18"
            title: "Из муки — тесто и хлеб"
            x: 20.00d
            y: 0.00d
            icon: "create:propeller"
            shape: "gear"
            size: 1.20d
            dependencies: [
                "82EB3ADD3D2CD6B9"
            ]
            description: [
                "Обработайте материал воздушным потоком. Полезный первый опыт — промыть пшеничную муку потоком через воду: получится тесто. Затем обработайте тесто потоком через зажжённый костёр и получите хлеб."
                "Так ваша мастерская начинает снабжать вылазки едой. Дальше освоим смешивание и жидкости, чтобы расширить ассортимент. Само достижение этого шага засчитывает обработку потоком, а не весь маршрут выпечки."
            ]
            tasks: [
                {
                    id: "3B94C74FCBF2893C"
                    type: "advancement"
                    advancement: "create:fan_processing"
