	quest_links: [ ]
	quests: [
		{
			id: "1D1395D17D6238DB"
			title: "Четыре проекта мастерской"
			description: [
				"Странд писал, что против машин Зодчих нужны свои машины. Начните с андезитового сплава — из него собирают почти всё в мастерской."
				"Дальше четыре направления — энергия, кухонный конвейер, подвижные машины и трубы. Берите любое."
			]
			x: 0.0d
			y: 0.0d
			icon: "create:andesite_alloy"
			icon_scale: 0.6d
			shape: "milestone"
			size: 1.8d
