                    id: "FED06116F509EA58"
                    type: "xp"
                    xp: 100
                }
                {
                    id: "FDC723AC81F66457"
                    type: "item"
                    item: { Count: 1b, id: "immersive_aircraft:telescope" }
                }
            ]
        }
