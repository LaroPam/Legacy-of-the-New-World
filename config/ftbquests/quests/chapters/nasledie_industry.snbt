    quests: [
        {
            id: "9A09307A8AC167F1"
            title: "Латунь для самостоятельной фабрики"
            x: 0.00d
            y: 0.00d
            icon: "create:brass_ingot"
            shape: "gear"
            size: 1.20d
            description: [
                "Получите латунный слиток: смешайте медь и цинк в чаше под миксером с нагревом от горелки. Латунь открывает точные механизмы, механические руки и более сложную сборку."
                "В этой главе цель — освободить ваши руки: собрать точный механизм, научить руку переносить материалы и запустить мощную дробилку. Дополнительные маршруты ведут к проволоке на электроприводе, муке от дизельной мельницы и большой котельной. Выберите полезный для вашей базы результат и двигайтесь по его ветке."
            ]
            tasks: [
                {
                    id: "8A72E65DD3CF79C5"
                    type: "advancement"
                    advancement: "create:brass"
                }
            ]
            rewards: [
                {
                    id: "E581D85438CDD01D"
                    type: "xp"
                    xp: 75
                }
                {
                    id: "2CABC3B9CC32114B"
                    type: "item"
                    item: { Count: 1b, id: "createaddition:multimeter" }
                }
            ]
        }
        {
