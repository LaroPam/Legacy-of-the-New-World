		{
			id: "418BF87D0F99A324"
			title: "Поводок для спектра"
			description: ["В пустоте между островами плывут спектры — призрачные родичи фантомов. Приманите одного сердцем души из Нижнего мира и накиньте поводок — он потащит вас к новым островам."]
			x: 0.0d
			y: -5.25d
			icon: "alexsmobs:soul_heart"
			icon_scale: 0.6d
			optional: true
			dependencies: ["34B69B58C4015C3F"]
