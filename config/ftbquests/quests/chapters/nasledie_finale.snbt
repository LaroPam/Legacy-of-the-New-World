		{
			id: "548DB0A9A973A90D"
			title: "Капсид эндериофага"
			description: ["По равнинам Края бродят эндериофаги — биомеханические вирусы ростом с человека. С разбитого падает капсид; положите в него рыбу или личинку, и он переделает её во что-то странное."]
			x: 4.5d
			y: -2.75d
			icon: "alexsmobs:capsid"
			icon_scale: 0.6d
			dependencies: ["34B69B58C4015C3F"]
