	quests: [
		{
			id: "34B69B58C4015C3F"
			title: "Шаг за рамку"
			description: ["Двенадцать очей встают в рамку, и портал, который Зодчие запирали последним, открывается. Пока жив дракон, обратной дороги нет — разве что через смерть. Тыква на голове, кстати, успокаивает эндерменов."]
			x: 1.75d
			y: -2.75d
			icon: "minecraft:end_portal_frame"
			icon_scale: 0.6d
			shape: "expedition"
			size: 1.2d
			dependencies: ["280C23723A869A8B"]
